# Azure AI Foundry / Azure OpenAI deployment details
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-06-01

# Restrict CORS to the deployed frontend once you know its URL
# (leave as * only for local testing).
ALLOWED_ORIGIN=*

PORT=8080

# Default language for the system prompt and score-note/label strings ("en" or "zh").
# Overridable per-request via the "lang" field on /api/chat, /api/patentability, /api/sensitivity.
DEFAULT_LANG=en

# Default jurisdiction for the Regional factor when a request doesn't specify target_jurisdiction.
# One of US / EP / JP / TW.
DEFAULT_TARGET_JURISDICTION=TW
