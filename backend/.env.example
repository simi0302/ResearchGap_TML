# Azure AI Foundry / Azure OpenAI deployment details
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-06-01

# Restrict CORS to the deployed frontend once you know its URL
# (leave as * only for local testing).
ALLOWED_ORIGIN=*

PORT=8080

# Optional: Bing Web Search (Azure Cognitive Services "Bing Search v7" resource) — powers the
# patent/web half of the search_prior_art tool (tools.js). Without this, that half returns an
# honest "unavailable" result instead of fabricating hits; the literature half (Semantic
# Scholar + Crossref + arXiv) works fully with no key at all. Get a key from the Azure portal
# once approved — note: standalone Bing Search v7 resources are retired for new Azure customers
# as of this writing, so this may need "Grounding with Bing Search" (Azure AI Agent Service)
# instead, which is a different integration than a simple API key.
BING_SEARCH_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
